# Dependencies (restore with `npm install`)
node_modules/

# Pipeline resumability cache — raw API/web responses + pre-crop photo
# originals. Not source of truth, not read by the app; regenerate by
# re-running the collect/enrich scripts (see CLAUDE.md, DATA_SOURCES.md).
# NOT the same as data/manual/ (tracked) — that holds hand-authored/curated inputs with no
# automated source; losing THOSE silently regresses the dataset (issue #3).
data/cache/

# Staging output of scripts/qgis_export.py — duplicates assets/geo/, which
# is the actual consumed geometry.
data/out/

# One-time geometry-pipeline inputs (issue #8, 2026-09-07) — Census cartographic-boundary county
# shapefiles and the NPS Yellowstone boundary shapefile, consumed once by scripts/qgis_export.py
# to produce assets/geo/**. Nothing the widget serves at runtime reads either. ~59MB combined;
# re-fetch URLs are in scripts/qgis_export.py's COUNTY_SHAPEFILE/YNP_BOUNDARY comments.
data/census/
data/nps/

# DevTools performance traces from freeze-hunting sessions (see PROGRESS.md).
traces/

# Python bytecode cache
__pycache__/
*.pyc

# OS/editor cruft
.DS_Store
*.swp

# Claude Code runtime lock state (ephemeral, per-session)
.claude/scheduled_tasks.lock

# One-time raw operator handoff (district-block-builder.html's round-trip export for the ca1/ca3
# alt sub-assembly layout, 2026-09-10) — converted into data/district_arrangement_alt.json by
# scripts/build_district_arrangement_alt.py, which is the actual consumed asset. Left in place,
# untouched, per the operator's own "make a copy of it, don't move/edit the original" instruction.
temp_alt_ca1_ca3.txt

# Same situation, earlier instance (issue #8, 2026-09-07) — the operator's own working file from
# district-block-builder.html (its early lines are an unrelated, out-of-scope linker export; the
# arrangement data lives from line 3747 on — see PROGRESS.md session (bq)). Verified byte-for-byte
# identical, after JSON-parsing that tail, to the actual consumed data/district_arrangement.json —
# so its content is fully superseded, not just "probably." Left in place rather than deleted,
# mirroring temp_alt_ca1_ca3.txt's precedent above: it's the operator's file, not this repo's.
temp_district_layout_data.txt

# Local scratch notes, not part of the repo.
.worklog.local.md
